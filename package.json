{
  "name": "personalcolor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "AIパーソナルカラー診断 — すべてブラウザ内（オンデバイス）で完結する無料・サーバーレスのWebアプリ",
  "scripts": {
    "prepare-assets": "node scripts/prepare-assets.mjs",
    "predev": "npm run prepare-assets",
    "dev": "vite",
    "prebuild": "npm run prepare-assets",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fontsource/noto-sans-jp": "^5.3.0",
    "@mediapipe/tasks-vision": "0.10.35",
    "heic2any": "0.0.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.1.2",
    "autoprefixer": "10.5.4",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.8.0",
    "postcss": "8.5.23",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5"
  }
}
